---
import '../styles/site.css';

const { title = 'Análisis y Desarrollo de Software (ADSO)', description = 'Una guía práctica de análisis y desarrollo de software.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="es">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="theme-color" content="#f7f8f6" /><link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} /><title>{title === 'Análisis y Desarrollo de Software (ADSO)' ? title : title + ' | Análisis y Desarrollo de Software (ADSO)'}</title></head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <div class="app-shell"><aside class="sidebar"><a class="brand" href={base}>LAB<span>/SDLC</span></a><p class="side-caption">GUÍA DE APRENDIZAJE</p><nav aria-label="Navegación principal"><a href={base}><span>⌂</span>Introducción</a><a href={base+'fases/'}><span>◉</span>El ciclo completo</a><p class="side-caption">FASES DEL PROCESO</p><a href={base+'fases/#problema'}><span>01</span>Problema</a><a href={base+'fases/#analisis'}><span>02</span>Requerimientos</a><a href={base+'fases/#diseno'}><span>03</span>Modelado</a><a href={base+'fases/#arquitectura'}><span>04</span>Arquitectura</a><a href={base+'fases/#desarrollo'}><span>05</span>Desarrollo</a><a href={base+'fases/#pruebas'}><span>06</span>Pruebas</a><a href={base+'fases/#despliegue'}><span>07</span>Despliegue</a><a href={base+'fases/#mantenimiento'}><span>08</span>Evolución</a><p class="side-caption">APRENDER HACIENDO</p><a href={base+'caso/'}><span>↗</span>Caso Taskflow</a><button id="theme-toggle" class="theme-toggle" type="button" aria-label="Cambiar a modo oscuro"><span>◐</span><span class="theme-label">Modo oscuro</span></button></nav><div class="sidebar-foot">ANÁLISIS · DISEÑO · SOFTWARE<br/><span>Una guía abierta y práctica</span></div></aside><div class="main-shell"><header class="mobile-header"><a class="brand" href={base}>LAB<span>/SDLC</span></a><button id="mobile-theme-toggle" class="theme-toggle" type="button" aria-label="Cambiar tema">◐</button></header><main id="contenido"><slot /></main><footer><a class="brand" href={base}>LAB<span>/SDLC</span></a><p>Guía abierta para aprender análisis y desarrollo de software.</p><a href="https://github.com/riveracrist">GitHub</a></footer></div></div>
  <script>
    import '../scripts/theme.js';
  </script>
  </body>
</html>
